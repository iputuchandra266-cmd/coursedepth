# Copy to .env and fill in what you use. Only PUBLIC_* values reach the browser.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Create a property at https://analytics.google.com/ then paste the ID here.
# Leave empty to disable GA4 (affiliate clicks will still be pushed to dataLayer).
PUBLIC_GA_ID=

# Optional: an endpoint that accepts a JSON POST body for every tracked event.
# Useful for a custom collector, Plausible proxy, or a serverless function.
PUBLIC_ANALYTICS_ENDPOINT=
