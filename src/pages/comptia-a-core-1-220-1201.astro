---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { courses } from "../data/courses";
import { u } from "../lib/u";

const site = "https://coursedepth.com";
const url = `${site}/comptia-a-core-1-220-1201/`;

const totalCourses = courses.length;
const comptiaCourses = courses.filter((c) => /comptia|a\+|220-1201/i.test(c.title) || /comptia|it-certification|220-1201/i.test(c.category));

const targetCourse = courses.find((c) => c.slug === "comptia-a-core-1-220-1201-full-course-practice-exam");
const courseRating = targetCourse ? targetCourse.rating : "N/A";
const courseReviews = targetCourse ? targetCourse.reviews.toLocaleString("en-US") : "N/A";
const courseUpdated = targetCourse ? targetCourse.updated : "N/A";

const faqs = [
  {
    q: "Is CompTIA A+ still relevant in 2026?",
    a: "Yes — CompTIA A+ remains the industry-standard entry-level certification for IT support, help desk, and field technician roles. The 220-1201 (Core 1) and 220-1202 (Core 2) exams were updated in 2025/2026 to include newer topics like cloud computing, virtualization, enhanced security fundamentals, and modern hardware (SSDs, USB4, Wi-Fi 6). Many employers still list A+ as a minimum requirement for junior IT roles, and it's a solid stepping point to Network+, Security+, and specialized tracks.",
  },
  {
    q: "What's the difference between 220-1101/1102 and 220-1201/1202?",
    a: "The 220-1201/1202 series (effective 2025) replaces the 220-1101/1102 series. Key differences: 220-1201 adds more on cloud concepts (AWS, Azure, Google Cloud), enhanced security topics (zero trust, basic cryptography), updated mobile device coverage (5G, eSIM, newer form factors), and revised hardware coverage (SSD standards, USB4, Wi-Fi 6E). If you started with 1101, sitting 1201 is recommended to get the most current content, but 1101 is still widely accepted by employers.",
  },
  {
    q: "How many hours should I study for A+ Core 1?",
    a: "Most learners need 80–120 hours of combined video instruction and hands-on practice. The Dion Training course alone is 26 hours of video, but adding practice exams, lab hardware (old PC for disassembly, Raspberry Pi for networking), and review time typically brings total study time to 3–4 months at 5–10 hours per week. Quality of practice questions matters more than pure hour count — aim for 85%+ on practice exams before scheduling.",
  },
  {
    q: "A+ vs self-taught: which is better for getting an IT job?",
    a: "A+ provides credential validation that many HR systems and recruiters filter by. Self-taught learners can build equivalent skills through home labs, free resources (CompTIA's own videos, YouTube), and volunteer/entry-level work. However, the certification opens more doors initially, especially for career-changers without a tech background. Many pros ultimately get both: certification + hands-on experience.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site + "/" },
        { "@type": "ListItem", position: 2, name: "CompTIA A+ Core 1 (220-1201)", item: url },
      ],
    },
    {
      "@type": "Article",
      headline: "CompTIA A+ Core 1 (220-1201) Full Course & Practice Exam — 2026 Guide",
      description: "Review, rating, update date, and 7-step checklist for choosing the best CompTIA A+ Core 1 (220-1201) course in 2026. Data-driven guide with real student reviews and update recency.",
      datePublished: "2026-10-21",
      dateModified: "2026-10-21",
      inLanguage: "en",
      author: { "@type": "Organization", name: "CourseDepth", url: site + "/" },
      publisher: { "@type": "Organization", name: "CourseDepth", url: site + "/", logo: { "@type": "ImageObject", url: site + "/images/logo-mark.svg" } },
      mainEntityOfPage: { "@type": "WebPage", "@id": url },
      speakable: { "@type": "SpeakableSpecification", cssSelector: [".lead"] },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
