---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const site = "https://coursedepth.com";
const url = `${site}/contact/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": `${url}#webpage`,
  url,
  name: "Contact CourseDepth",
  description: "Report a wrong course price or rating, ask a question, or contact the CourseDepth editorial team.",
  inLanguage: "en",
  isPartOf: { "@id": `${site}/#website` },
  about: { "@id": `${site}/#organization` },
};
---
<Layout title="Contact CourseDepth — Corrections & Questions" description="Report a wrong course price or rating, ask a question, or contact the CourseDepth editorial team. We reply within 2 business days.">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<Header />
<section class="page-hero"><div class="container"><h1>Contact CourseDepth</h1><p>Questions, corrections, or partnerships — we reply within 2 business days.</p></div></section>
<section class="section"><div class="container" style="max-width:720px">
<div class="review">
<h2 style="margin-top:0">Report a wrong price or rating</h2>
<p>Open an issue on GitHub with the course URL and what looks wrong. It is the fastest way to reach us and keeps a public record of the correction.</p>
<p><a class="btn-dark" href="https://github.com/iputuchandra266-cmd/coursedepth/issues/new" target="_blank" rel="noopener">Open a correction request →</a></p>
<h2>Partnerships &amp; other questions</h2>
<p>Message us on <a href="https://x.com/CouponsFreeDis1" target="_blank" rel="noopener">X</a> or <a href="https://www.facebook.com/dewi.s.bati/" target="_blank" rel="noopener">Facebook</a>.</p>
<p style="font-size:13px;color:var(--muted)">We reply within 2 business days. We do not sell courses or vouchers ourselves.</p>
</div>
</div></section>
<Footer />
</Layout>
