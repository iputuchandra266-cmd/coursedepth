---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Stars from "../../components/Stars.astro";
import CourseCard from "../../components/CourseCard.astro";
import { courses, getCourse } from "../../data/courses";
import { u } from "../../lib/u";
export function getStaticPaths() { return courses.map(c => ({ params: { slug: c.slug } })); }
const { slug } = Astro.params;
const course = getCourse(slug!);
if (!course) throw new Error("not found");
const others = courses.filter(c => c.slug !== course.slug && c.categorySlug === course.categorySlug).slice(0,3);
const fallback = courses.filter(c => c.slug !== course.slug).slice(0,3);
const rel = (others.length ? others : fallback);
const c = course;
const duration = String(c.duration ?? "").replace(" total", "") || "Self-paced";
const pct = c.ratingBreakdown ?? {};
const q = c.quality ?? {};
const cleanFaq = c.faq?.map((f) => ({
  q: f.q.replace(/^Is it worth the price\?$/i, "Is it worth it?"),
  a: f.a.replace(/^At \$[\d.,]+\s+with\s+/i, "With "),
}));
const t = (c.title.length > 38 ? c.title.slice(0, 38).trim() + "…" : c.title);
const title = `${t} Review | CourseDepth`;
const desc = `${c.title}: ${c.rating}★ from ${c.reviews.toLocaleString()} students, ${duration}. Curriculum, pros, cons & verdict.`.slice(0, 158);
const ld: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: c.title,
  description: c.description,
  provider: { "@type": "Organization", name: c.provider, sameAs: c.url },
  inLanguage: c.language ?? "en",
  url: c.url,
  image: c.image,
  ...(c.instructor ? { instructor: { "@type": "Person", name: c.instructor } } : {}),
  aggregateRating: { "@type": "AggregateRating", ratingValue: c.rating, reviewCount: c.reviews, bestRating: 5, worstRating: 1 },
};
const faqLd = cleanFaq?.length ? { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: cleanFaq.map(f => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) } : null;
---
<Layout title={title} description={desc} bodyClass={c.url ? "has-mobile-cta" : ""}>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
{faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
<Header />
<section class="course-head">
<div class="container">
  <nav class="crumbs" style="padding-top:14px">
    <a href={u("/")}>Home</a> › <a href={u("/programming")}>All categories</a> › <a href={u(`/programming/${c.categorySlug}`)}>{c.category}</a> › <span>{c.title.slice(0,40)}…</span>
  </nav>
  <div class="badges">
    <span class="chip active">{c.provider}</span>
    {c.bestseller && <span class="chip chip-hot">Bestseller</span>}
    <a class="chip" href={u(`/programming/${c.categorySlug}`)}>{c.category}</a>
    <span class="chip">{c.level}</span>
    {c.certificate && <span class="chip">Certificate</span>}
  </div>
  <h1 style="max-width:820px">{c.title}</h1>
  <p style="max-width:760px">{c.description}</p>
  <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin:12px 0 0">
    <span style="font-size:2rem;font-weight:800">{c.rating}</span>
    <Stars rating={c.rating} reviews={c.reviews} />
    <a href="#reviews" style="font-weight:600">({c.reviews.toLocaleString()} reviews)</a>
    <span>Created by: <b>{c.instructor}</b></span>
    {c.instructorImage && <img src={c.instructorImage} alt={c.instructor} style="width:40px;height:40px;border-radius:50%;object-fit:cover;" />}
    <span style="color:#cfc4f5">Last updated {c.updated}</span>
  </div>
  {c.url && (
    <div class="course-cta">
      <div class="course-cta__price">
        <b>{c.price ? `$${c.price}` : "See price"}</b>
        {c.oldPrice ? <s>${c.oldPrice}</s> : null}
        <small>on {c.provider}</small>
      </div>
      <a class="btn-dark" href={c.url} target="_blank" rel="sponsored nofollow noopener" data-course={c.slug} data-provider={c.provider} data-placement="course-hero">Check price on {c.provider} →</a>
    </div>
  )}
</div>
</section>
<section class="section" style="padding-top:26px"><div class="container detail-grid">
  <div class="detail-main">
    <div class="review" style="border-left:4px solid var(--yellow)">
      <h3 style="margin-top:0">Our take</h3>
      <p>{c.summary}</p>
      <p><b>Best for:</b> {c.bestFor}. <b>Skip it if:</b> {c.skipIf}.</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px">
        <div><b>✅ Pros</b><ul style="margin:6px 0;padding-left:18px;color:var(--text)">{c.pros?.map(p => <li>{p}</li>)}</ul></div>
        <div><b>❌ Cons</b><ul style="margin:6px 0;padding-left:18px;color:var(--text)">{c.cons?.map(p => <li>{p}</li>)}</ul></div>
      </div>
    </div>
    <div class="review"><h3>📘 What you will learn</h3><ul>{c.learn?.map(l => <li>{l}</li>)}</ul></div>
    <div class="review"><h3>📑 Course content</h3>
      <p>{c.sections} sections · {c.lectures} lectures · {duration} of video · updated {c.updated}</p>
      <ol>{c.curriculum?.map(s => <li><b>{s.title}</b> — {s.lectures} lectures · {s.duration}</li>)}</ol>
    </div>
    <div class="review"><h3>🎯 Who it is for</h3><p><b>Suits:</b> {c.suits}.</p><p><b>Needs:</b> {c.requirements}</p></div>
    {q.total && <div class="review"><h3>📊 Quality score</h3>
      <p>Content ⭐ {q.content} · Video ⭐ {q.video} · Instructor ⭐ {q.instructor} · Pace ⭐ {q.pace} · Depth ⭐ {q.depth}</p>
      <p><b>Overall: {q.total} / 100</b> — based on student ratings and review depth.</p></div>}
    <div class="review"><h3>👤 Instructor</h3><p><b>{c.instructor}</b> — {c.instructorBio}</p><a href={u(`/instructors#${c.instructorSlug || ""}`)} style="font-weight:700">All courses by {c.instructor} →</a></div>
    {cleanFaq?.length && <div class="review"><h3>❓ FAQ</h3>{cleanFaq.map(f => <div style="margin-bottom:10px"><b>{f.q}</b><p style="margin:4px 0 0;color:var(--text)">{f.a}</p></div>)}</div>}
    <h2 id="reviews" style="margin-top:24px">Student ratings ({c.reviews.toLocaleString()})</h2>
    <div class="review">
      <b>{c.rating} · {c.reviews.toLocaleString()} ratings on {c.provider}</b>
      {[5,4,3,2,1].map(n => <div style="display:flex;gap:8px;align-items:center;margin:4px 0;font-size:14px">
        <span style="width:36px">⭐ {n}</span>
        <span style="flex:1;background:var(--star-off);border-radius:4px;height:8px;overflow:hidden"><span style="display:block;height:100%;width:{pct[n] ?? 0}%;background:var(--yellow)"></span></span>
        <span style="width:42px;text-align:right;color:var(--muted)">{pct[n] ?? 0}%</span>
      </div>)}
      <p style="margin:10px 0 0;font-size:13px;color:var(--muted)">These are the provider's aggregate ratings. The analysis above is written by CourseDepth — we do not publish invented student quotes.</p>
      {c.url && <a href={c.url} class="btn-price" style="margin-top:10px" target="_blank" rel="sponsored nofollow noopener" data-course={c.slug} data-provider={c.provider} data-placement="course-ratings">Read the original reviews on {c.provider} →</a>}
    </div>
    <h2 style="margin-top:24px">Related courses</h2>
    <div class="course-grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">{rel.map(x => <CourseCard course={x} />)}</div>
  </div>
  <aside class="side-card">
    <div class="course-thumb" style="border-radius:10px;overflow:hidden"><img src={u(c.image ?? `/images/courses/${c.slug}.svg`)} alt={c.title} width="640" height="360" /></div>
    <div style="margin:6px 0"><Stars rating={c.rating} reviews={c.reviews} showCount={false} /></div>
    {c.url ? (
      <>
        <a href={c.url} class="btn-dark" style="display:flex;width:100%;margin-top:10px" target="_blank" rel="sponsored nofollow noopener" data-course={c.slug} data-provider={c.provider} data-placement="course-sidebar">Check price on {c.provider} →</a>
        <a href={c.url} class="btn-review" style="display:flex;justify-content:center;margin-top:10px" target="_blank" rel="sponsored nofollow noopener" data-course={c.slug} data-provider={c.provider} data-placement="course-sidebar-reviews">Read all reviews →</a>
      </>
    ) : (
      <p style="margin-top:10px;font-size:13px;color:var(--muted)">Price and link unavailable for this course right now.</p>
    )}
    <hr />
    <div style="font-size:14px;display:grid;gap:6px">
      <div>💵 Price: <b>{c.price ? `$${c.price}` : "See price on provider"}</b></div>
      <div>⏱ Video Duration: <b>{duration}</b></div>
      <div>🏢 Provider: <b>{c.provider}</b></div>
      <div>🔄 Updated: <b>{c.updated}</b></div>
      <div>📶 Level: <b>{c.level}</b></div>
      <div>🌐 Language: <b>{c.language}</b></div>
      <div>🎓 Certificate: <b>{c.certificate ? "Yes" : "No"}</b></div>
      <div>📚 Lectures: <b>{c.lectures} in {c.sections} sections</b></div>
      <div>♾️ Access: <b>{c.access}</b></div>
      <div>👥 Students: <b>{c.students?.toLocaleString()}</b></div>
      <div>↩️ Money-back: <b>{c.moneyBack ? "30 days" : "No"}</b></div>
    </div>
    <p style="font-size:12px;color:var(--muted)">{c.moneyBack ? "30-day money-back on most paid courses. " : ""}Some links earn us commission at no cost to you.</p>
  </aside>
</div></section>
{c.url && (
  <div class="mobile-cta">
    <div class="mobile-cta__price">
      <b>{c.price ? `$${c.price}` : "See price"}</b>
      <small>on {c.provider}</small>
    </div>
    <a class="btn-dark" href={c.url} target="_blank" rel="sponsored nofollow noopener" data-course={c.slug} data-provider={c.provider} data-placement="course-mobile-sticky">Check price →</a>
  </div>
)}
<Footer />
</Layout>
