---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { posts } from "../../data/posts";
import { u } from "../../lib/u";
---
<Layout title="Blog — Guides and comparisons — CourseDepth">
<Header />
<section class="page-hero"><div class="container"><h1>Guides and comparisons</h1><p>Honest roundups based on real student reviews.</p></div></section>
<section class="section"><div class="container"><div class="blog-grid">
{posts.map(p => (
  <article class="post-card">
    <span class="post-thumb"><img src={u(`/images/blog/${p.slug}.svg`)} alt={p.title} width="640" height="300" loading="lazy" /></span>
    <div class="post-body"><time>{p.date} • {p.category}</time><h3>{p.title}</h3><p style="color:var(--muted);font-size:14px">{p.excerpt}</p></div>
  </article>
))}
</div></div></section>
<Footer />
</Layout>
