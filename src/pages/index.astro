---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CourseCard from "../components/CourseCard.astro";
import { categories } from "../data/categories";
import { courses, providers } from "../data/courses";
import { instructors } from "../data/instructors";
import { u } from "../lib/u";

const topTopics = [...categories].sort((a,b)=>b.courses-a.courses).slice(0,12);
const topInstructors = instructors.slice(0,8);
const parseUpdated = (u) => { const [m,y]=String(u||"").split("/"); return (parseInt(y)||0)*100+(parseInt(m)||0); };
const topRated = [...courses].sort((a,b)=> (b.rating||0)-(a.rating||0) || (b.reviews||0)-(a.reviews||0) ).slice(0,8);
const fresh = [...courses].sort((a,b)=> parseUpdated(b.updated)-parseUpdated(a.updated) ).slice(0,8);
const totalReviews = courses.reduce((s,c)=>s+(c.reviews||0),0);
const jsonLd = {"@context":"https://schema.org","@graph":[
  {"@type":"Organization","@id":"https://coursedepth.com/#org","name":"CourseDepth","url":"https://coursedepth.com/","logo":"https://coursedepth.com/images/og-default.png","sameAs":[]},
  {"@type":"WebSite","@id":"https://coursedepth.com/#site","url":"https://coursedepth.com/","name":"CourseDepth","publisher":{"@id":"https://coursedepth.com/#org"},"potentialAction":{"@type":"SearchAction","target":"https://coursedepth.com/search?q={search_term_string}","query-input":"required name=search_term_string"}},
  {"@type":"FAQPage","mainEntity":[
    {"@type":"Question","name":"Are course reviews reliable?","acceptedAnswer":{"@type":"Answer","text":"CourseDepth aggregates public ratings and review counts from each course provider, then adds editorial analysis (our take, pros/cons, update history) that the provider does not show. The headline rating is the provider's own aggregate score, not a score we invent."}},
    {"@type":"Question","name":"How do I find the best courses?","acceptedAnswer":{"@type":"Answer","text":"Sort by student rating (4.5+ is excellent), check the last update date (within 12 months is ideal), read the curriculum breakdown, and look at instructor review counts. CourseDepth lists all of this on every course page."}},
    {"@type":"Question","name":"Are online courses worth it in 2026?","acceptedAnswer":{"@type":"Answer","text":"Yes, when you choose by outcome, rating and freshness. A course rated 4.5+ with 1,000+ reviews and an update within the last year is usually worth the time. The real risk is choosing a course you will never finish."}}
  ]},
  {"@type":"ItemList","name":"Highest Rated Courses","itemListElement":topRated.map((c,i)=>({"@type":"ListItem","position":i+1,"item":{"@type":"Course","name":c.title,"url":"https://coursedepth.com/course/"+c.slug+"/","provider":{"@type":"Organization","name":c.provider},"aggregateRating":{"@type":"AggregateRating","ratingValue":c.rating,"reviewCount":c.reviews}}}))}
]};
---

<Layout title="Course Reviews 2026 — Ratings & Best Picks | CourseDepth" description="Honest course reviews with real student ratings, update dates and instructor details. Compare the best Python, Web Dev, Data Science and AI courses before you buy.">


<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<Header />

<!-- HERO -->
<section class="hero">
  <div class="container hero-grid">
    <div>
      <h1>Course Reviews <br /><span style="font-weight:400;font-size:.7em">Real Ratings & Best Picks 2026</span></h1>
      <p class="hero-sub">Independent reviews of online courses — ratings, update history and current price checks.</p>
      <form class="hero-search" action={u("/search")} method="get" role="search">
        <input type="search" name="q" placeholder="Search courses ..." aria-label="Search courses" />
        <button type="submit">Search</button>
      </form>
      <p class="popular"><span>Popular:</span>
        <a href={u("/programming/python")}>Python</a>
        <a href={u("/programming/javascript")}>JavaScript</a>
        <a href={u("/programming/data-science")}>Data Science</a>
        <a href={u("/programming/excel")}>Excel</a>
        <a href={u("/vouchers")}>Vouchers</a>
      </p>
    </div>
    <img class="hero-art" src={u("/images/hero.svg")} alt="" width="640" height="440" fetchpriority="high" decoding="async" />
  </div>
</section>
<section class="hero-providers" aria-label="Course data source">
  <div class="container marquee">
    <span class="label">COURSE DATA FROM</span>
    <div class={providers.length > 1 ? "marquee-track" : "marquee-track is-static"}>
      {providers.map(p => <span class="provider-word">{p}</span>)}
    </div>
    <a class="pill-more" href={u("/courses")}>{courses.length} courses checked →</a>
  </div>
</section>

<!-- BROWSE BY TOPIC -->
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="sec-head">
      <div><h2>Browse by topic</h2><p>Pick a subject to see its best courses</p></div>
    </div>
    <div class="topic-grid">
      {topTopics.map(t => (
        <a class="topic-card" href={u(`/programming/${t.slug}`)}>
          <span class="topic-ico"><img src={u(`/images/categories/${t.slug}.svg`)} alt={t.name} width="64" height="64" loading="lazy" /></span>
          <span><b>{t.name}</b><small>{t.courses} {t.courses === 1 ? "course" : "courses"}</small></span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- TOP RATED -->
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="sec-head">
      <div><span class="eyebrow">Top rated</span><h2>Courses students rate highest</h2></div>
      <a class="link-more" href={u("/courses")}>Browse all courses →</a>
    </div>
    <div class="course-grid">
      {topRated.map(c => <CourseCard course={c} />)}
    </div>
  </div>
</section>

<!-- WHY -->
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="sec-head"><div><span class="eyebrow">Why CourseDepth</span><h2>Choose with confidence</h2></div></div>
    <div class="why-grid">
      <div class="why-card"><div class="why-ico">🌍</div><div><h3>Every course in one place</h3><p>{courses.length} {providers.join(", ")} courses, compared by rating, freshness and curriculum — not by who pays.</p></div></div>
      <div class="why-card"><div class="why-ico">⭐</div><div><h3>{(totalReviews / 1e6).toFixed(1)}M student ratings</h3><p>Aggregated from public ratings on the provider. A paid placement cannot bury or remove a rating.</p></div></div>
      <div class="why-card"><div class="why-ico">🔎</div><div><h3>Details you will not find elsewhere</h3><p>Video length, difficulty, price, certificates and language, checked for each course.</p></div></div>
    </div>
  </div>
</section>

<!-- INSTRUCTORS -->
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="sec-head">
      <div><span class="eyebrow">Most reviewed</span><h2>Instructors students trust most</h2></div>
      <a class="link-more" href={u("/instructors")}>The top 10, ranked →</a>
    </div>
    <div class="inst-grid">
      {topInstructors.map(i => (
        <a class="inst-card" href={u("/instructors")}>
          <span class="avatar"><img src={u(i.image ?? `/images/instructors/${i.slug}.svg`)} alt={i.name} width="44" height="44" loading="lazy" /></span>
          <span><b>{i.name}</b><small>{i.courses} courses, {i.reviews} reviews</small></span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- FRESH -->
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="sec-head">
      <div><span class="eyebrow">Fresh content</span><h2>Recently updated courses</h2></div>
    </div>
    <div class="course-grid">
      {fresh.map(c => <CourseCard course={c} />)}
    </div>
  </div>
</section>


<!-- FAQ (GEO/AI) -->
<section class="section" style="padding-top:0" aria-label="Frequently asked questions about course reviews">
  <div class="container">
    <div class="sec-head"><div><span class="eyebrow">FAQ</span><h2>Course reviews — common questions</h2></div></div>
    <div class="why-grid">
      <div class="why-card"><div><h3>Are course reviews reliable?</h3><p>Yes. CourseDepth aggregates public ratings and review counts from each provider, then adds editorial analysis (our take, pros/cons, update history) that the provider itself does not show. The headline rating is the provider's own aggregate score, not a score we invent.</p></div></div>
      <div class="why-card"><div><h3>How do I find the best courses?</h3><p>Sort by student rating (4.5+ is excellent), check the last update date (within 12 months is ideal), read the curriculum breakdown, and look at instructor review counts. CourseDepth lists all of this on every course page.</p></div></div>
      <div class="why-card"><div><h3>Are online courses worth it in 2026?</h3><p>Yes, when you choose by outcome, rating and freshness. A course rated 4.5+ with 1,000+ reviews and an update within the last year is usually worth the time. The real risk is choosing a course you will never finish.</p></div></div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="sec-head"><div><span class="eyebrow">How it works</span><h2>Three steps to the right course</h2></div></div>
    <div class="steps">
      <div class="step"><h3>Search or browse</h3><p>Type a course or instructor name, or start from one of {categories.length} topics ranked by student rating.</p></div>
      <div class="step"><h3>Compare the details</h3><p>Ratings, review counts, length, level and what other students say, on one page per course.</p></div>
      <div class="step"><h3>Enrol on the provider's site</h3><p>Every course links straight to where it is sold. Some links earn us a commission, at no cost to you.</p></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta">
  <div class="container">
    <div class="cta-inner">
      <div><h2>See the current course deals</h2><p>We check the price and the rating before listing a deal. Compare what is discounted right now, then open the course on the provider.</p></div>
      <a class="btn-dark" href={u("/vouchers")}>🎟 Browse deals</a>
    </div>
  </div>
</section>

<Footer />
</Layout>
