---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { u } from "../lib/u";
---
<Layout title="Accounts — CourseDepth" description="CourseDepth does not have user accounts yet. Browse every course, compare ratings and check current deals without signing in." robots="noindex, nofollow">
<Header />
<section class="page-hero"><div class="container"><h1>Accounts are coming later</h1><p>CourseDepth does not have user accounts yet. Everything on the site is free to read without signing in.</p></div></section>
<section class="section"><div class="container" style="max-width:620px">
<div class="review">
<h2 style="margin-top:0">What you can do now</h2>
<ul>
  <li><a href={u("/courses")}>Browse every course</a> and compare ratings, price and update dates.</li>
  <li><a href={u("/vouchers")}>Check current deals</a> before you buy.</li>
  <li><a href={u("/contact")}>Contact us</a> if a price or rating looks wrong.</li>
</ul>
</div>
</div></section>
<Footer />
</Layout>
