---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { categories, groups } from "../../data/categories";
import { u } from "../../lib/u";
---
<Layout title="All Course Categories — Reviews & Prices | CourseDepth" description={`Browse ${categories.length} course topics — ratings, prices and update history for every category.`}>
<Header />
<section class="page-hero"><div class="container"><h1>Browse every category</h1><p>{categories.length} topics across {groups.length} groups, ranked by student reviews.</p></div></section>
<section class="section"><div class="container">
{groups.map(g => (
  <div style="margin-bottom:28px">
    <h2 id={`group-${g.toLowerCase().replace(/[^a-z0-9]+/g,'-')}`} style="color:var(--navy)">{g}</h2>
    <div class="topic-grid">
      {categories.filter(c=>c.group===g).map(c => (
        <a class="topic-card" href={u(`/programming/${c.slug}`)}>
          <span class="topic-ico"><img src={u(`/images/categories/${c.slug}.svg`)} alt={c.name} width="64" height="64" loading="lazy" /></span>
          <span><b>{c.name}</b><small>{c.courses} {c.courses === 1 ? "course" : "courses"}</small></span>
        </a>
      ))}
    </div>
  </div>
))}
</div></section>
<Footer />
</Layout>
