---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CourseCard from "../../components/CourseCard.astro";
import { courses, providers } from "../../data/courses";

const site = "https://coursedepth.com";
const url = `${site}/courses/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site + "/" },
        { "@type": "ListItem", position: 2, name: "All courses", item: url },
      ],
    },
    {
      "@type": "CollectionPage",
      "@id": `${url}#webpage`,
      url,
      name: "All Online Courses A-Z — Reviews & Ratings",
      description: `Browse all ${courses.length} online courses CourseDepth tracks, with student ratings, prices and update dates.`,
      inLanguage: "en",
      isPartOf: { "@id": `${site}/#website` },
      mainEntity: {
        "@type": "ItemList",
        name: "All online courses A-Z",
        numberOfItems: courses.length,
        itemListElement: courses.map((c, i) => ({
          "@type": "ListItem",
          position: i + 1,
          item: {
            "@type": "Course",
            name: c.title,
            url: `${site}/course/${c.slug}/`,
            provider: { "@type": "Organization", name: c.provider },
            aggregateRating: { "@type": "AggregateRating", ratingValue: c.rating, reviewCount: c.reviews },
          },
        })),
      },
    },
  ],
};
---
<Layout
  title="All Online Courses A-Z — Reviews & Ratings | CourseDepth"
  description={`Browse all ${courses.length} online courses we track from ${providers.length} providers. Student ratings, prices, levels and last-update dates, filterable in one list.`}
>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<Header />
<section class="page-hero"><div class="container"><h1>All online courses A-Z</h1><p>{courses.length} courses • {providers.length} provider{providers.length === 1 ? "" : "s"} • filter the list live below.</p></div></section>
<section class="section"><div class="container">
  <p style="max-width:760px;color:var(--muted)">Every course CourseDepth tracks, in one alphabetical list. Each card shows the student rating, review count and topic, and every course has a full review with curriculum, pros, cons and the last update date. Use the filter to jump to a subject, instructor or provider.</p>
  <input id="q" placeholder="Filter courses…" aria-label="Filter courses" style="width:100%;border:2px solid var(--navy);border-radius:12px;padding:13px 15px;font-size:16px;margin-top:16px" />
  <div class="course-grid" id="grid" style="margin-top:16px">
    {courses.map(c => <div class="js-item" data-title={(c.title+c.instructor+c.category+c.provider).toLowerCase()}><CourseCard course={c} /></div>)}
  </div>
</div></section>
<Footer />
</Layout>
<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const items = [...document.querySelectorAll('.js-item')] as HTMLElement[];
  q?.addEventListener('input', () => {
    const v = q.value.toLowerCase();
    items.forEach(el => { el.style.display = (el.dataset.title||'').includes(v) ? '' : 'none'; });
  });
</script>
