---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { courses, providers } from "../data/courses";

const site = "https://coursedepth.com";
const url = `${site}/about-us/`;
const totalReviews = courses.reduce((s, c) => s + (c.reviews || 0), 0);
const reviewsLabel = totalReviews >= 1e6 ? `${(totalReviews / 1e6).toFixed(1)} million` : totalReviews.toLocaleString("en-US");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${url}#webpage`,
      url,
      name: "About CourseDepth — Independent Course Reviews",
      description: "CourseDepth publishes independent online course reviews built from public student ratings, review counts, update dates and curriculum checks.",
      inLanguage: "en",
      isPartOf: { "@id": `${site}/#website` },
      about: { "@id": `${site}/#organization` },
      mainEntity: {
        "@type": "Organization",
        "@id": `${site}/#organization`,
        name: "CourseDepth",
        url: `${site}/`,
        description: "Independent online course reviews, ratings and price comparisons.",
      },
    },
  ],
};
---
<Layout
  title="About CourseDepth — Independent Course Reviews"
  description={`Who is behind CourseDepth: ${courses.length} online courses from ${providers.length} providers, ${reviewsLabel} student ratings, and a no-paid-placement review policy.`}
>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<Header />
<section class="page-hero"><div class="container"><h1>About CourseDepth</h1><p>Independent ratings, price checks and update history for online courses — all in one place.</p></div></section>
<section class="section"><div class="container" style="max-width:760px">
<h2>What CourseDepth does</h2>
<p>CourseDepth is an independent review site for online courses. We collect the public student rating, review count, price, length and last-update date for every course we track, then add an editorial breakdown of who the course suits and where it falls short. Today we compare {courses.length} courses from {providers.length} providers, backed by {reviewsLabel} student ratings.</p>
<h2>How we rank courses</h2>
<p>Rankings are based on average rating × review volume, update freshness, and curriculum completeness. Providers cannot pay to boost, bury, or remove a listing.</p>
<div class="why-grid why-grid-2" style="margin-top:16px">
<div class="why-card"><div class="why-ico">⭐</div><h3>Millions of student ratings</h3><p>Aggregated from the public ratings students leave on the provider.</p></div>
<div class="why-card"><div class="why-ico">🌍</div><h3>{providers.length} provider{providers.length === 1 ? "" : "s"}</h3><p>{courses.length} {providers.join(", ")} courses, checked by our editorial team.</p></div>
</div>
<h2>How we make money</h2>
<p>Some course links are affiliate links. If you enrol through one, the provider may pay us a commission at no extra cost to you. Commission never changes a rating, a ranking or whether a course is included. Every page shows the same checks whether a link pays us or not.</p>
<h2>Corrections</h2>
<p>Prices and ratings change often. If something looks wrong, <a href="/contact">send us the course link</a> and we will re-check it against the provider. You can also read our full <a href="/how-we-rate-courses">review methodology</a>.</p>
</div></section>
<Footer />
</Layout>
