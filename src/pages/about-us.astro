---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<Layout title="About us — CourseDepth">
<Header />
<section class="page-hero"><div class="container"><h1>About CourseDepth</h1><p>Real student reviews, prices and details for online courses — all in one place.</p></div></section>
<section class="section"><div class="container" style="max-width:760px">
<h2>How we rank courses</h2>
<p>Rankings are based on average rating × review volume, update freshness, and curriculum completeness. Providers cannot pay to boost, bury, or remove reviews.</p>
<div class="why-grid" style="grid-template-columns:1fr 1fr;margin-top:16px">
<div class="why-card"><div class="why-ico">⭐</div><h3>1.3M real reviews</h3><p>Written by verified students who took the course.</p></div>
<div class="why-card"><div class="why-ico">🌍</div><h3>150+ providers</h3><p>Udemy, Coursera, edX, Udacity, Pluralsight, YouTube and more.</p></div>
</div>
</div></section>
<Footer />
</Layout>
