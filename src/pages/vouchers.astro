</style>

<script>
  const grid = document.getElementById("voucherGrid");
  const search = document.getElementById("voucherSearch") as HTMLInputElement | null;
  const sort = document.getElementById("dealSort") as HTMLSelectElement | null;
  const count = document.getElementById("dealsCount");
  const empty = document.getElementById("dealsEmpty");
  const more = document.getElementById("showMore") as HTMLButtonElement | null;
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>(".deal-filter")];

  const PAGE_SIZE = 12;
  let activeFilter = "all";
  let visible = PAGE_SIZE;

  const allCards = () => [...(grid?.querySelectorAll<HTMLElement>(".voucher-card") ?? [])];

  const matchesFilter = (card: HTMLElement) => {
    switch (activeFilter) {
      case "saving": return Number(card.dataset.discount) > 0;
      case "under20": return Number(card.dataset.price) < 20;
      case "rated": return Number(card.dataset.rating) >= 4.5;
      case "cert": return card.dataset.cert === "1";
      case "beginner": return card.dataset.beginner === "1";
      case "fresh": return card.dataset.fresh === "1";
      default: return true;
    }
  };

  const matchesSearch = (card: HTMLElement) => {
    const q = (search?.value ?? "").trim().toLowerCase();
    return !q || (card.dataset.title ?? "").includes(q);
  };

  const sortCards = () => {
    if (!grid || !sort) return;
    const mode = sort.value;
    const sorted = allCards().sort((a, b) => {
      const index = Number(a.dataset.index) - Number(b.dataset.index);
      if (mode === "saving") {
        return Number(b.dataset.discount) - Number(a.dataset.discount) || index;
      }
      if (mode === "price") {
        return Number(a.dataset.price) - Number(b.dataset.price) || Number(b.dataset.rating) - Number(a.dataset.rating);
      }
      if (mode === "rating") {
        return Number(b.dataset.rating) - Number(a.dataset.rating) || Number(b.dataset.reviews) - Number(a.dataset.reviews);
      }
      if (mode === "reviews") {
        return Number(b.dataset.reviews) - Number(a.dataset.reviews);
      }
      return index;
    });
    sorted.forEach((card) => grid.appendChild(card));
  };

  const render = (reset = false) => {
    if (reset) visible = PAGE_SIZE;
    const cards = allCards();
    const matching = cards.filter((card) => matchesFilter(card) && matchesSearch(card));

    cards.forEach((card) => { card.hidden = true; });
    matching.slice(0, visible).forEach((card) => { card.hidden = false; });

    if (count) {
      const shown = Math.min(visible, matching.length);
      const label = `deal${matching.length === 1 ? "" : "s"}`;
      count.innerHTML = `<b>${matching.length}</b> ${label} found${matching.length > shown ? ` · showing ${shown}` : ""}`;
    }
    empty?.classList.toggle("show", matching.length === 0);

    if (more) {
      const remaining = Math.max(0, matching.length - visible);
      more.hidden = remaining === 0;
      more.textContent = remaining ? `Show more deals (${remaining})` : "Show more deals";
    }
  };

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeFilter = button.dataset.filter ?? "all";
      filterButtons.forEach((b) => b.classList.toggle("active", b === button));
      render(true);
    });
  });

  search?.addEventListener("input", () => render(true));
  sort?.addEventListener("change", () => {
    sortCards();
    render(true);
  });
  more?.addEventListener("click", () => {
    visible += PAGE_SIZE;
    render(false);
  });

  grid?.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-copy]");
    if (!button) return;
    const code = button.dataset.copy ?? "";
    let copied = false;
    try {
      await navigator.clipboard.writeText(code);
      copied = true;
    } catch {
      /* Clipboard can be blocked; the code is still visible to select manually. */
    }
    const label = (text: string) => {
      const span = document.createElement("span");
      span.textContent = text;
      button.replaceChildren(document.createTextNode(`${code} `), span);
    };
    button.dataset.copied = copied ? "true" : "false";
    label(copied ? "Copied!" : "Copy failed");
    window.setTimeout(() => {
      button.dataset.copied = "false";
      label("Copy");
    }, 1600);
  });

  sortCards();
  render(true);
</script>
