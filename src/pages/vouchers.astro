---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Stars from "../components/Stars.astro";
import {
  vouchers,
  featuredVoucher,
  voucherStats,
  certificationVoucherUrl,
  certificationVoucherUrlAlt,
} from "../data/vouchers";
import { u } from "../lib/u";

const featured = featuredVoucher;
const deals = vouchers.filter((v) => v.id !== featured?.id);

const money = (n: number) => (Number.isInteger(n) ? `$${n}` : `$${n.toFixed(2)}`);
const updatedLabel = new Date().toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const filters = [
  { k: "all", label: "All deals" },
  { k: "saving", label: "Biggest savings" },
  { k: "under20", label: "Under $20" },
  { k: "rated", label: "4.5★ & up" },
  { k: "cert", label: "Certificate" },
  { k: "beginner", label: "Beginner friendly" },
  { k: "fresh", label: "Updated 2026" },
];

const faqs = [
  {
    q: "Are these course vouchers free?",
    a: "Yes. CourseDepth does not charge for vouchers or deal links. When you claim a deal you go straight to the provider, and the price shown there is the price you pay.",
  },
  {
    q: "Do I need a coupon code?",
    a: "Usually not. Most provider discounts are applied automatically through the link, so there is no code to type. If a real code is available for a course, it appears in the voucher card with a copy button.",
  },
  {
    q: "Why do course prices change so often?",
    a: "Online course providers run frequent promotions, regional pricing and limited-time launches. We check the prices shown here regularly, but the final price at checkout is always the one that counts.",
  },
  {
    q: "How does CourseDepth choose which deals to list?",
    a: "We start with the courses we already review and only list deals with a clear price. Deals are ordered by real saving first, then student rating and review volume — providers cannot pay for a better position.",
  },
  {
    q: "Are these courses actually worth buying?",
    a: "A discount is not a reason to buy on its own. Read the course review, check the rating, review count, last update date and curriculum, then decide whether it matches your goal. Our how-we-rate guide explains the checks we use.",
  },
  {
    q: "Do you sell certification exam vouchers?",
    a: "We do not sell vouchers ourselves. We link to Udemy's certification voucher page, where you can compare official exam vouchers for AWS, Azure, CompTIA and other certifications. Always confirm the exam, region and validity period before buying.",
  },
  {
    q: "How often is this page updated?",
    a: `Prices and links are checked regularly, with the latest review on ${updatedLabel}. If a deal has expired, the provider page will show the current price instead.`,
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://coursedepth.com/" },
        { "@type": "ListItem", position: 2, name: "Course vouchers & deals", item: "https://coursedepth.com/vouchers/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "ItemList",
      name: "Course vouchers and deals",
      numberOfItems: vouchers.length,
      itemListElement: vouchers.slice(0, 20).map((v, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "Course",
          name: v.course.title,
          url: `https://coursedepth.com/course/${v.course.slug}/`,
          provider: { "@type": "Organization", name: v.course.provider },
          aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: v.course.rating,
            reviewCount: v.course.reviews,
          },
          offers: {
            "@type": "Offer",
            price: v.price,
            priceCurrency: "USD",
            availability: "https://schema.org/InStock",
            url: v.course.url ?? `https://coursedepth.com/course/${v.course.slug}/`,
          },
        },
      })),
    },
  ],
};
---

<Layout
  title={`Course Vouchers & Deals 2026 — Save Up to ${voucherStats.maxDiscount}% | CourseDepth`}
  description={`${voucherStats.total} verified course vouchers and discounts, including ${voucherStats.under20} deals under $20. No fake codes — claim the deal and the price is applied at the provider.`}
>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<Header />

<!-- HERO -->
<section class="vouchers-hero">
  <div class="container">
    <div class="vouchers-hero-grid">
      <div class="hero-copy">
        <span class="hero-eyebrow">🎟 CourseDepth vouchers</span>
        <h1>The best course deals, <mark>already unlocked.</mark></h1>
        <p class="lede">
          Curated discounts on the online courses we review. No coupon hunting,
          no expired codes — just a clear price and a direct link to the course.
        </p>
        <div class="hero-search-voucher">
          <input
            type="search"
            id="voucherSearch"
            placeholder="Search deals by course, topic or instructor…"
            aria-label="Search vouchers"
            autocomplete="off"
          />
        </div>
        <a
          class="hero-exam-link"
          href={certificationVoucherUrl}
          target="_blank"
          rel="sponsored nofollow noopener"
        >🎓 Looking for exam vouchers? AWS, Azure &amp; CompTIA →</a>
        <div class="hero-stats">
          <div class="hero-stat"><b>{voucherStats.total}</b><span>deals tracked</span></div>
          <div class="hero-stat"><b>Up to {voucherStats.maxDiscount}%</b><span>off</span></div>
          <div class="hero-stat"><b>{voucherStats.under20}</b><span>under $20</span></div>
          <div class="hero-stat"><b>{voucherStats.rated45}</b><span>rated 4.5★+</span></div>
        </div>
      </div>

      <div class="hero-ticket-wrap" aria-hidden="true">
        <div class="hero-ticket">
          <div class="ticket-top">
            <span>COURSEDEPTH</span>
            <span class="ticket-live"><i></i> LIVE DEAL</span>
          </div>
          <div class="ticket-discount">UP TO <b>{voucherStats.maxDiscount}%</b> OFF</div>
          <p>Curated course vouchers, all in one place.</p>
          <div class="ticket-perf"><span>✂</span></div>
          <div class="ticket-bottom">
            <div><small>NO CODE NEEDED</small><b>Tap. Claim. Learn.</b></div>
            <div class="ticket-barcode"></div>
          </div>
        </div>
        <span class="ticket-float ticket-float-a">✓ Prices checked</span>
        <span class="ticket-float ticket-float-b">🔥 {voucherStats.total} deals</span>
      </div>
    </div>
  </div>
</section>

<div class="voucher-trust">
  <div class="container voucher-trust-inner">
    <span>✓ No fake coupon codes</span>
    <span>✓ Prices last reviewed {updatedLabel}</span>
    <span>✓ Direct links to the provider</span>
    <span>✓ Some links earn us a commission</span>
  </div>
</div>

<!-- FEATURED DEAL -->
{featured && (
  <section class="section spotlight-section">
    <div class="container">
      <div class="spotlight">
        <div class="spotlight-media">
          <img
            src={u(featured.course.image ?? `/images/courses/${featured.course.slug}.svg`)}
            alt={featured.course.title}
            width="720"
            height="405"
            loading="eager"
          />
          <span class="spotlight-ribbon">Biggest saving</span>
          <span class="spotlight-save">{featured.discount ? `−${featured.discount}%` : "TODAY"}</span>
        </div>
        <div class="spotlight-body">
          <span class="eyebrow">Featured voucher</span>
          <h2>{featured.course.title}</h2>
          <p>{featured.course.description}</p>
          <div class="spotlight-meta">
            <Stars rating={featured.course.rating} reviews={featured.course.reviews} />
            <span>{featured.course.provider}</span>
            <span>{featured.course.level}</span>
            <span>{featured.course.duration}</span>
          </div>
          <div class="spotlight-price">
            <b>{money(featured.price)}</b>
            {featured.oldPrice && <s>{money(featured.oldPrice)}</s>}
            {featured.discount > 0 && <span>Save {money(featured.saving)} ({featured.discount}%)</span>}
          </div>
          <div class="spotlight-actions">
            <a
              class="btn-dark"
              href={featured.course.url ?? u(`/course/${featured.course.slug}`)}
              target={featured.course.url ? "_blank" : undefined}
              rel={featured.course.url ? "sponsored nofollow noopener" : undefined}
              data-course={featured.course.slug}
              data-provider={featured.course.provider}
              data-placement="voucher-featured"
            >Claim this deal →</a>
            <a class="btn-ghost" href={u(`/course/${featured.course.slug}`)}>Read the review</a>
          </div>
          <div class="spotlight-note">
            <span class="note-dot"></span>
            <span>
              No code needed — the discount is applied through our link.
              Price checked {updatedLabel}.
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<!-- CERTIFICATION VOUCHERS -->
<section class="section cert-section">
  <div class="container">
    <div class="cert-banner">
      <div class="cert-copy">
        <span class="eyebrow" style="color:var(--yellow)">Official exam vouchers</span>
        <h2>Certification exam vouchers, in one place</h2>
        <p>
          Looking for an exam voucher instead of a course deal? Udemy lists official
          certification vouchers for AWS, Azure, CompTIA, Cisco and more — with the
          current price and availability shown on their site.
        </p>
        <ul class="cert-points">
          <li>AWS, Azure, CompTIA, Cisco and other IT exams</li>
          <li>Official certification vouchers sold by Udemy</li>
          <li>Compare the current price before you buy</li>
        </ul>
        <a
          class="btn-dark"
          href={certificationVoucherUrlAlt}
          target="_blank"
          rel="sponsored nofollow noopener"
        >Browse certification vouchers →</a>
      </div>

      <div class="cert-art" aria-hidden="true">
        <div class="cert-card">
          <span class="cert-card-top">OFFICIAL VOUCHER</span>
          <b>AWS</b>
          <span>Certification exam</span>
          <div class="cert-seal">✓</div>
          <div class="cert-lines"><i></i><i></i><i></i></div>
          <div class="cert-card-foot"><span>EXAM</span><span>VERIFIED</span></div>
        </div>
        <span class="cert-float">Save on your exam</span>
      </div>
    </div>
  </div>
</section>

<!-- ALL DEALS -->
<section class="section" id="deals">
  <div class="container">
    <div class="sec-head">
      <div>
        <span class="eyebrow">All vouchers</span>
        <h2>{deals.length} more course deals</h2>
        <p>Filter by what matters, then claim the price at the provider.</p>
      </div>
    </div>

    <div class="deals-toolbar">
      <div class="deal-filters" role="group" aria-label="Filter vouchers">
        {filters.map((f, i) => (
          <button
            type="button"
            class:list={["deal-filter", { active: i === 0 }]}
            data-filter={f.k}
          >{f.label}</button>
        ))}
      </div>
      <label class="deal-sort">
        Sort
        <select id="dealSort">
          <option value="featured">Best matches</option>
          <option value="saving">Biggest saving</option>
          <option value="price">Lowest price</option>
          <option value="rating">Highest rated</option>
          <option value="reviews">Most reviewed</option>
        </select>
      </label>
    </div>

    <p class="deals-count" id="dealsCount"><b>{deals.length}</b> deals available</p>

    <div class="voucher-grid" id="voucherGrid">
      {deals.map((v, i) => (
        <article
          class="voucher-card"
          data-index={i}
          data-title={(v.course.title + " " + v.course.instructor + " " + v.course.category + " " + v.course.provider).toLowerCase()}
          data-discount={v.discount}
          data-price={v.price}
          data-rating={v.course.rating}
          data-reviews={v.course.reviews}
          data-cert={v.course.certificate ? "1" : "0"}
          data-beginner={/beginner/i.test(v.course.level ?? "") ? "1" : "0"}
          data-fresh={/2026/.test(v.course.updated ?? "") ? "1" : "0"}
        >
          <div class="voucher-media">
            <a href={u(`/course/${v.course.slug}`)} aria-label={v.course.title}>
              <img
                src={u(v.course.image ?? `/images/courses/${v.course.slug}.svg`)}
                alt={v.course.title}
                width="640"
                height="360"
                loading="lazy"
              />
            </a>
            <span class:list={["voucher-discount", { muted: !v.discount }]}>
              {v.discount ? `−${v.discount}%` : "DEAL"}
            </span>
            <span class="voucher-provider">{v.course.provider}</span>
          </div>

          <div class="voucher-body">
            <div class="voucher-cat">{v.course.category}</div>
            <h3 class="voucher-title">
              <a href={u(`/course/${v.course.slug}`)}>{v.course.title}</a>
            </h3>
            <div class="voucher-meta">
              <Stars rating={v.course.rating} reviews={v.course.reviews} />
              <span>{v.course.level}</span>
            </div>
          </div>

          <div class="voucher-foot">
            <div class="voucher-price-row">
              <div class="voucher-price">
                {money(v.price)}
                {v.oldPrice && <s class="voucher-old">{money(v.oldPrice)}</s>}
              </div>
              <span class="voucher-saving">
                {v.discount ? `Save ${money(v.saving)}` : "Best price"}
              </span>
            </div>
            <div class="voucher-redeem">
              {v.code ? (
                <button
                  class="voucher-code code-button"
                  type="button"
                  data-copy={v.code}
                  title={`Copy code ${v.code}`}
                >{v.code} <span>Copy</span></button>
              ) : (
                <span class="voucher-code auto">No code needed</span>
              )}
              <a
                class="voucher-btn"
                href={v.course.url ?? u(`/course/${v.course.slug}`)}
                target={v.course.url ? "_blank" : undefined}
                rel={v.course.url ? "sponsored nofollow noopener" : undefined}
                data-course={v.course.slug}
                data-provider={v.course.provider}
                data-placement="voucher-list"
              >Claim →</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="deals-empty" id="dealsEmpty">
      <span>🔍</span>
      <h3>No deals match that search</h3>
      <p>Try a different keyword or clear the filters to see every voucher.</p>
    </div>

    <div class="deals-more-wrap">
      <button class="btn-outline" id="showMore" type="button">Show more deals</button>
    </div>
  </div>
</section>

<!-- HOW TO REDEEM -->
<section class="section soft">
  <div class="container">
    <div class="sec-head">
      <div>
        <span class="eyebrow">How it works</span>
        <h2>Redeem a voucher in three steps</h2>
        <p>No account with CourseDepth needed. No coupon code to hunt for.</p>
      </div>
    </div>
    <div class="steps">
      <div class="step">
        <h3>Pick your deal</h3>
        <p>Filter by saving, price or rating, then open the course review if you want the full breakdown before buying.</p>
      </div>
      <div class="step">
        <h3>Claim the voucher</h3>
        <p>Tap “Claim” and we send you to the provider with the current offer attached. If a real code is listed, copy it first.</p>
      </div>
      <div class="step">
        <h3>Check the checkout price</h3>
        <p>The provider’s checkout is always the final word. Confirm the price, currency and what is included before you enrol.</p>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section" aria-label="Voucher questions">
  <div class="container">
    <div class="sec-head">
      <div>
        <span class="eyebrow">FAQ</span>
        <h2>Course voucher questions</h2>
        <p>What the deals are, how they work and what to check before you buy.</p>
      </div>
    </div>
    <div class="voucher-faq">
      {faqs.map((f) => (
        <details class="faq-d">
          <summary>{f.q}</summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta">
  <div class="container">
    <div class="cta-inner">
      <div>
        <h2>A deal is only good if the course is right</h2>
        <p>
          Read the student rating, review count, update date and curriculum before you
          spend anything. Our reviews show all four on one page — no provider can pay
          to change the score.
        </p>
      </div>
      <a class="btn-dark" href={u("/courses")}>Browse all courses →</a>
    </div>
  </div>
</section>

<Footer />
</Layout>

<style>
  /* ===== Hero ===== */
  .vouchers-hero {
    position: relative;
    overflow: hidden;
    padding: 54px 0 46px;
    color: #fff;
    background:
      radial-gradient(900px 480px at 82% 8%, rgba(255, 201, 0, 0.18), transparent 60%),
      radial-gradient(700px 420px at 2% 100%, rgba(106, 52, 211, 0.65), transparent 65%),
      linear-gradient(135deg, var(--purple-deep) 0%, #2a1a6b 52%, var(--purple) 100%);
  }
  .vouchers-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.32;
    background-image: radial-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .vouchers-hero .container { position: relative; z-index: 1; }
  .vouchers-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 34px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .vouchers-hero-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 44px; }
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border: 1px solid rgba(255, 201, 0, 0.38);
    border-radius: 999px;
    background: rgba(255, 201, 0, 0.13);
    color: #ffe27a;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .vouchers-hero h1 {
    margin: 16px 0 14px;
    color: #fff;
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }
  .vouchers-hero h1 mark {
    padding: 0 0.08em;
    color: #fff;
    background: linear-gradient(transparent 58%, rgba(255, 201, 0, 0.5) 58%);
  }
  .vouchers-hero .lede {
    max-width: 58ch;
    margin: 0 0 22px;
    color: #d8d2f3;
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.16rem);
    line-height: 1.65;
  }
  .hero-search-voucher {
    position: relative;
    max-width: 560px;
    padding: 6px;
    border-radius: 15px;
    background: #fff;
    box-shadow: 0 20px 44px -20px rgba(0, 0, 0, 0.65);
  }
  .hero-search-voucher::before {
    content: "⌕";
    position: absolute;
    top: 50%;
    left: 18px;
    z-index: 1;
    color: var(--faint);
    font-size: 21px;
    line-height: 1;
    transform: translateY(-50%);
  }
  .hero-search-voucher input {
    width: 100%;
    height: 48px;
    padding: 0 16px 0 44px;
    border: 0;
    border-radius: 11px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    outline: none;
  }
  .hero-search-voucher:focus-within { box-shadow: 0 0 0 4px rgba(255, 201, 0, 0.32), 0 20px 44px -20px rgba(0, 0, 0, 0.65); }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 0;
    margin-top: 24px;
  }
  .hero-stat { display: flex; flex-direction: column; padding-right: 22px; }
  .hero-stat + .hero-stat { padding-left: 22px; border-left: 1px solid rgba(255, 255, 255, 0.18); }
  .hero-stat b {
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
  }
  .hero-stat span {
    margin-top: 5px;
    color: #bfb6e8;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  @media (max-width: 520px) {
    .hero-stat { padding-right: 14px; }
    .hero-stat + .hero-stat { padding-left: 14px; }
    .hero-stat b { font-size: 1.25rem; }
  }
  .hero-exam-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    padding-bottom: 2px;
    border-bottom: 1px dashed rgba(255, 226, 122, 0.55);
    color: #ffe27a;
    font-size: 0.86rem;
    font-weight: 700;
  }
  .hero-exam-link:hover { color: #fff; border-color: #fff; }

  /* Decorative ticket */
  .hero-ticket-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 18px 0;
  }
  .hero-ticket {
    position: relative;
    width: min(100%, 420px);
    padding: 24px 26px 20px;
    border-radius: 20px;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 34px 80px -24px rgba(0, 0, 0, 0.72);
    transform: rotate(-4.5deg);
  }
  .hero-ticket::after {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px dashed rgba(19, 26, 58, 0.12);
    border-radius: 14px;
    pointer-events: none;
  }
  .ticket-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--faint);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }
  .ticket-live {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--green);
    letter-spacing: 0.06em;
  }
  .ticket-live i {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px rgba(21, 128, 61, 0.12);
  }
  .ticket-discount {
    margin-top: 18px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .ticket-discount b {
    display: inline-block;
    margin: 0 2px;
    color: var(--purple);
    font-size: clamp(2.6rem, 2rem + 3vw, 4rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
