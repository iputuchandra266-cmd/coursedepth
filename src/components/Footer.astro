---
import { u } from "../lib/u";
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="logo" href={u("/")} style="color:#fff">
        <span class="logo-mark" style="background:var(--yellow);color:var(--ink)">🎓</span>
        <span>Course<em style="color:#ffc900">Depth</em></span>
      </a>
      <p>Real student reviews, prices and details for online courses from Udemy, Coursera, edX, YouTube and dozens more, all in one place.</p>
      <div class="socials">
        <a href="#" aria-label="Facebook">f</a>
        <a href="#" aria-label="X">𝕏</a>
        <a href="#" aria-label="LinkedIn">in</a>
        <a href="#" aria-label="Discord">💬</a>
      </div>
    </div>
    <div>
      <h4>Browse</h4>
      <a href={u("/programming")}>All categories</a>
      <a href={u("/programming/python")}>Python</a>
      <a href={u("/programming/javascript")}>JavaScript</a>
      <a href={u("/programming/data-science")}>Data Science</a>
      <a href={u("/programming/excel")}>Excel</a>
      <a href={u("/courses")}>All courses A-Z</a>
      <a href={u("/instructors")}>All instructors A-Z</a>
    </div>
    <div>
      <h4>Company</h4>
      <a href={u("/about-us")}>About us</a>
      <a href={u("/blog")}>Blog</a>
      <a href={u("/review-course")}>Write a review</a>
      <a href={u("/contact")}>Contact</a>
      <a href={u("/login")}>My account</a>
    </div>
    <div>
      <h4>Small print</h4>
      <a href={u("/terms")}>Terms & conditions</a>
      <a href={u("/privacy")}>Privacy policy</a>
      <a href={u("/cookies")}>Cookie policy</a>
      <a href={u("/code-of-conduct")}>Code of conduct</a>
    </div>
    <div>
      <h4>Weekly newsletter</h4>
      <p style="font-size:14px;margin:0">The best new courses, deals and reviews, once a week. No spam.</p>
      <form class="newsletter" onsubmit="return false">
        <input placeholder="Email address" aria-label="Email" />
        <button>Subscribe</button>
      </form>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© 2026 CourseDepth built with Astro.js — All rights reserved.</span>
    <span>Some links are affiliate links, at no cost to you. <a href={u("/about-us")} style="display:inline;color:#fff">How we rank →</a></span>
  </div>
</footer>
