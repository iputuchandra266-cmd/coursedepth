---
import { u } from "../lib/u";
import { courses, providers } from "../data/courses";
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="logo" href={u("/")} style="color:#fff">
        <img class="logo-mark" src={u("/images/logo-mark.svg")} alt="" width="40" height="40" />
        <span>Course<em style="color:#ffc900">Depth</em></span>
      </a>
      <p>{courses.length} {providers.join(", ")} courses with independent ratings, price checks and update history — all in one place.</p>
      <div class="socials">
        <a href="https://www.facebook.com/dewi.s.bati/" aria-label="Facebook">f</a>
        <a href="https://x.com/CouponsFreeDis1" aria-label="X">𝕏</a>
      </div>
    </div>
    <div>
      <h4>Browse</h4>
      <a href={u("/programming")}>All categories</a>
      <a href={u("/programming/python")}>Python</a>
      <a href={u("/programming/javascript")}>JavaScript</a>
      <a href={u("/programming/data-science")}>Data Science</a>
      <a href={u("/programming/excel")}>Excel</a>
      <a href={u("/courses")}>All courses A-Z</a>
      <a href={u("/instructors")}>All instructors A-Z</a>
      <a href={u("/vouchers")}>Vouchers & deals</a>
    </div>
    <div>
      <h4>Company</h4>
      <a href={u("/about-us")}>About us</a>
      <a href={u("/contact")}>Contact</a>
      <a href={u("/how-we-rate-courses")}>How we rate</a>
    </div>
    <div>
      <h4>Course reviews</h4>
      <a href={u("/udemy-python-course-reviews")}>Python course reviews</a>
      <a href={u("/are-udemy-courses-worth-it")}>Are online courses worth it?</a>
      <a href={u("/are-udemy-reviews-fake")}>Are course reviews fake?</a>
      <a href={u("/how-to-choose-an-online-course")}>How to choose a course</a>
      <a href={u("/udemy-certificate-worth-it")}>Are course certificates worth it?</a>
      <a href={u("/how-we-rate-courses")}>How we rate courses</a>
    </div>
    <div>
      <h4>Small print</h4>
      <a href={u("/terms")}>Terms & conditions</a>
      <a href={u("/privacy")}>Privacy policy</a>
      <a href={u("/cookies")}>Cookie policy</a>
      <a href={u("/code-of-conduct")}>Code of conduct</a>
    </div>
    <div>
      <h4>Follow &amp; corrections</h4>
      <p style="font-size:14px;margin:0">New reviews and deals are posted on X and Facebook. Spotted a wrong price? Tell us.</p>
      <div class="socials">
        <a href="https://x.com/CouponsFreeDis1" aria-label="X">𝕏</a>
        <a href="https://www.facebook.com/dewi.s.bati/" aria-label="Facebook">f</a>
      </div>
      <a href={u("/contact")} style="margin-top:10px">Send a correction →</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© 2026 CourseDepth built with Astro.js — All rights reserved.</span>
    <span>Some links are affiliate links, at no cost to you. <a href={u("/how-we-rate-courses")} style="display:inline;color:#fff">How we rank →</a></span>
  </div>
</footer>
