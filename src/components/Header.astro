---
import { u } from "../lib/u";
---
<header class="site-header">
  <div class="container header-main">
    <a class="logo" href={u("/")} aria-label="CourseDepth home">
      <img class="logo-mark" src={u("/images/logo-mark.svg")} alt="" width="40" height="40" />
      <span>Course<em>Depth</em></span>
    </a>

    <a class="btn-cats" href={u("/programming")} aria-label="Categories">▦ Categories ▾</a>

    <form class="searchbar" action={u("/search")} method="get" role="search" autocomplete="off">
      <input type="search" name="q" placeholder="Search courses, instructors, topics..." aria-label="Search courses" />
      <button type="submit">Search</button>
    </form>

    <div class="header-actions">
      <a class="btn-review" href={u("/review-course")} title="Write a review">✎ Write a review</a>
      <a class="btn-sign" href={u("/login")} title="Sign in">👤 Sign in</a>
    </div>
    <button class="mobile-toggle" id="mobileBtn" aria-label="Menu">☰</button>
  </div>
</header>

<nav class="subnav" aria-label="Browse">
  <div class="container subnav-inner">
    <div class="subnav-links">
      <a href={u("/about-us")}>About</a>
      <a href={u("/contact")}>Contact</a>
    </div>
  </div>
</nav>
