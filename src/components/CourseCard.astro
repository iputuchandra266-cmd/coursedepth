---
import Stars from "./Stars.astro";
import type { Course } from "../data/courses";
import { u } from "../lib/u";
interface Props { course: Course }
const { course } = Astro.props;
---
<article class="course-card">
  <a class="course-thumb" href={u(`/course/${course.slug}`)} aria-label={course.title}>
    <img src={u(course.image ?? `/images/courses/${course.slug}.svg`)} alt={course.title} width="640" height="360" loading="lazy" />
    {course.bestseller && <span class="badge-best">Bestseller</span>}
  </a>
  <div class="course-body">
    <div class="course-meta"><a href={u(`/programming/${course.categorySlug}`)}>{course.category}</a></div>
    <h3 class="course-title"><a href={u(`/course/${course.slug}`)}>{course.title}</a></h3>
    <p class="course-desc">{course.description}</p>
    <div class="course-meta course-by">by <a href={u(`/instructors`)}>{course.instructor}</a></div>
    <div class="price-row">
      <span class="cd-rating"><Stars rating={course.rating} reviews={course.reviews} /></span>
    </div>
  </div>
</article>
