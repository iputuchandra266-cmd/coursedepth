---
interface Props {
  title?: string;
  description?: string;
  robots?: string;
  bodyClass?: string;
  /** Absolute URL or site-relative path. Defaults to /images/og-default.png. */
  image?: string;
  /** Open Graph type. Use "article" for guides and reviews. */
  type?: "website" | "article";
}
const {
  title = "Course Reviews — Ratings & Best Picks | CourseDepth",
  description = "Honest course reviews: ratings, update history and instructor details for the best Python, Web Dev, Data Science and AI courses.",
  robots = "index, follow",
  bodyClass = "",
  image,
  type = "website",
} = Astro.props;
import "../styles/global.css";
import { u } from "../lib/u";

// Analytics is opt-in at build time. Set PUBLIC_GA_ID to enable GA4.
// PUBLIC_ANALYTICS_ENDPOINT is optional and receives a JSON beacon for each event.
const gaId = (import.meta.env.PUBLIC_GA_ID as string | undefined)?.trim();
const analyticsEndpoint = (import.meta.env.PUBLIC_ANALYTICS_ENDPOINT as string | undefined)?.trim() ?? "";

const site = Astro.site ?? new URL("https://coursedepth.com");
const canonical = new URL(Astro.url.pathname, site).href;
const siteName = "CourseDepth";
const orgId = `${site.origin}/#organization`;
const websiteId = `${site.origin}/#website`;
const defaultImage = new URL(u("/images/og-default.png"), site).href;
const ogImage = image ? new URL(u(image), site).href : defaultImage;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: siteName,
      url: `${site.origin}/`,
      logo: {
        "@type": "ImageObject",
        url: new URL(u("/images/logo-mark.svg"), site).href,
      },
      sameAs: [
        "https://x.com/CouponsFreeDis1",
        "https://www.facebook.com/dewi.s.bati/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: siteName,
      alternateName: "Course Reviews",
      url: `${site.origin}/`,
      description,
      inLanguage: "en",
      publisher: { "@id": orgId },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${site.origin}/search?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content="10yuLeZ2qhvag_zD9PkjLG49rg10la3f57_12DpOSDA" />
    <meta name="impact-site-verification" value="a3c4b02b-2856-448c-8029-c3576b09819a" />
    <script type="text/javascript" is:inline>(function(i,m,p,a,c,t){c.ire_o=p;c[p]=c[p]||function(){(c[p].a=c[p].a||[]).push(arguments)};t=a.createElement(m);var z=a.getElementsByTagName(m)[0];t.async=1;t.src=i;z.parentNode.insertBefore(t,z)})('https://utt.impactcdn.com/P-A8130614-cdfc-4568-9a5e-edd5b3c446851.js','script','impactStat',document,window);impactStat('transformLinks');impactStat('trackImpression');</script>
    <meta name="theme-color" content="#243693" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={u("/favicon.svg")} />
    <link rel="alternate icon" href={u("/favicon.ico")} sizes="any" />
    <link rel="sitemap" href={u("/sitemap.xml")} />

    <meta name="author" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag("js", new Date());
          gtag("config", gaId, { anonymize_ip: true });
        </script>
      </>
    )}

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3534671891943282" crossorigin="anonymous"></script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />

    <script is:inline define:vars={{ analyticsEndpoint }}>
      (function () {
        window.dataLayer = window.dataLayer || [];

        function track(name, params) {
          var payload = Object.assign(
            { event: name, page_path: location.pathname },
            params || {}
          );
          if (typeof window.gtag === "function") {
            window.gtag("event", name, params || {});
          } else {
            window.dataLayer.push(payload);
          }
          if (analyticsEndpoint && navigator.sendBeacon) {
            try {
              navigator.sendBeacon(
                analyticsEndpoint,
                new Blob([JSON.stringify(payload)], { type: "application/json" })
              );
            } catch (e) {}
          }
          if (location.hostname === "localhost" || location.hostname === "127.0.0.1") {
            console.debug("[analytics]", name, payload);
          }
        }
        window.cdTrack = track;

        document.addEventListener(
          "click",
          function (e) {
            var el = e.target;
            if (!el || !el.closest) return;
            var a = el.closest("a");
            if (!a) return;

            var href = a.getAttribute("href") || "";
            var rel = a.getAttribute("rel") || "";
            var isAffiliate =
              rel.indexOf("sponsored") !== -1 ||
              /trk\.udemy\.com|udemy\.com\/.*(aff|track)|clickbank|awin1\.com|partnerstack|impact\.com/i.test(href);
            var isExternal =
              /^https?:\/\//i.test(href) &&
              href.indexOf(location.hostname) === -1;

            if (!isAffiliate && !isExternal) return;

            var holder = a.closest("[data-course]");
            track(isAffiliate ? "affiliate_click" : "outbound_click", {
              link_url: href,
              link_text: (a.textContent || "").trim().slice(0, 80),
              course_slug: a.getAttribute("data-course") || (holder ? holder.getAttribute("data-course") : "") || "",
              provider: a.getAttribute("data-provider") || "",
              placement: a.getAttribute("data-placement") || "",
            });
          },
          true
        );
      })();
    </script>
  </body>
</html>
