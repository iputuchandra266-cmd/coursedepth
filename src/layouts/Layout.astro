---
interface Props {
  title?: string;
  description?: string;
  robots?: string;
}
const {
  title = "Course Reviews — Ratings & Best Picks | CourseDepth",
  description = "Honest course reviews: ratings, update history and instructor details for the best Python, Web Dev, Data Science and AI courses.",
  robots = "index, follow",
} = Astro.props;
import "../styles/global.css";
import { u } from "../lib/u";

const site = Astro.site ?? new URL("https://coursedepth.com");
const canonical = new URL(Astro.url.pathname, site).href;
const siteName = "CourseDepth";
const keyword = "Course Reviews";
const ld = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  alternateName: keyword,
  url: site.href,
  description,
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: `${site.href}?q={search_term_string}` },
    "query-input": "required name=search_term_string",
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content="10yuLeZ2qhvag_zD9PkjLG49rg10la3f57_12DpOSDA" />
    <meta name="impact-site-verification" value="a3c4b02b-2856-448c-8029-c3576b09819a" />
    <script type="text/javascript" is:inline>(function(i,m,p,a,c,t){c.ire_o=p;c[p]=c[p]||function(){(c[p].a=c[p].a||[]).push(arguments)};t=a.createElement(m);var z=a.getElementsByTagName(m)[0];t.async=1;t.src=i;z.parentNode.insertBefore(t,z)})('https://utt.impactcdn.com/P-A8130614-cdfc-4568-9a5e-edd5b3c446851.js','script','impactStat',document,window);impactStat('transformLinks');impactStat('trackImpression');</script>
    <meta name="theme-color" content="#243693" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={u("/favicon.svg")} />
    <link rel="alternate icon" href={u("/favicon.ico")} sizes="any" />
    <link rel="sitemap" href={u("/sitemap.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(u("/images/og-default.png"), site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(u("/images/og-default.png"), site).href} />

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3534671891943282" crossorigin="anonymous"></script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
